# ATLAS Intelligence Engine — .gitignore

# ─── Environment / Secrets ───
.env
.env.local
.env.*.local
*.env

# ─── OS files ───
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Editor directories ───
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ─── Node (if used for local server) ───
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ─── Build outputs ───
dist/
build/
.cache/
.parcel-cache/

# ─── Deployment artifacts ───
.netlify/
.vercel/

# ─── Logs ───
*.log
logs/

# ─── Temporary files ───
*.tmp
*.temp
*.bak
*.orig

# ─── Intelligence exports ───
# Uncomment to exclude exported JSON reports from git
# atlas-*.json
